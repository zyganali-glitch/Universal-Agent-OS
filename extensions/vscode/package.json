{
  "name": "universal-agent-os-vscode",
  "displayName": "Universal Agent OS",
  "description": "Enterprise IDE extension for the Universal Agent OS consultation-first governance framework.",
  "version": "1.4.3",
  "publisher": "mehmet-aydogan",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyganali-glitch/Universal-Agent-OS.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agent-os.initWorkspace",
        "title": "Agent OS: Init Workspace"
      },
      {
        "command": "agent-os.startPhase0",
        "title": "Agent OS: Start Phase-0 Interview"
      },
      {
        "command": "agent-os.verifyGovernance",
        "title": "Agent OS: Verify Governance Gate"
      }
    ],
    "configuration": {
      "title": "Universal Agent OS",
      "properties": {
        "agentOS.antiMonolithLimit": {
          "type": "number",
          "default": 400,
          "description": "Line limit before Agent OS triggers Anti-Monolith warning."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@types/node": "^26.0.1"
  }
}
