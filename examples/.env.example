# Universal Agent OS — Example Environment Variables
#
# Copy this file to .env in your project root and fill in the values.
# NEVER commit the .env file with real secrets to version control.

# =============================================================================
# Application Mode
# =============================================================================
# Set to "true" for offline/demo mode without external API calls.
# Set to "false" for production mode with real API integrations.
MOCK_MODE=true

# =============================================================================
# LLM / AI Provider (if applicable)
# =============================================================================
# Uncomment and configure for your chosen AI provider.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# =============================================================================
# Application Settings
# =============================================================================
# APP_PORT=8000
# APP_HOST=0.0.0.0
# APP_DEBUG=false
# APP_SECRET_KEY=

# =============================================================================
# Database (if applicable)
# =============================================================================
# DATABASE_URL=
# DATABASE_NAME=

# =============================================================================
# External Service Integrations
# =============================================================================
# Add provider-specific variables here as your project requires them.
# Follow the pattern: SERVICE_VARIABLE_NAME=value
